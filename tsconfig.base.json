{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "useUnknownInCatchVariables": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "noEmitOnError": true,
    "baseUrl": ".",
    "paths": {
      "@opsense/ai-codex": ["packages/ai-codex/src/index.ts"],
      "@opsense/agent-runtime": ["packages/agent-runtime/src/index.ts"],
      "@opsense/ai-provider": ["packages/ai-provider/src/index.ts"],
      "@opsense/collectors": ["packages/collectors/src/index.ts"],
      "@opsense/core": ["packages/core/src/index.ts"],
      "@opsense/redaction": ["packages/redaction/src/index.ts"],
      "@opsense/report": ["packages/report/src/index.ts"],
      "@opsense/projection": ["packages/projection/src/index.ts"],
      "@opsense/schema": ["packages/schema/src/index.ts"],
      "@opsense/ssh": ["packages/ssh/src/index.ts"],
      "@opsense/workspace": ["packages/workspace/src/index.ts"],
      "@opsense/wiki": ["packages/wiki/src/index.ts"]
    }
  }
}
